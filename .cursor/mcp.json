{
  "mcpServers": {
    "linear": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/sse"]
    },
    "Notion": {
      "url": "https://mcp.notion.com/mcp",
      "headers": {}
    },
    "Figma": {
      "url": "https://mcp.figma.com/mcp",
      "headers": {}
    },
    "Sanity": {
      "url": "https://mcp.sanity.io",
      "type": "http",
      "headers": {}
    },
    "tessl": {
      "type": "stdio",
      "command": "tessl",
      "args": ["mcp", "start"]
    }
  }
}
