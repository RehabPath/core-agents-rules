{
  "name": "core-llm-rules",
  "version": "1.0.0",
  "description": "Shared AI assistant rules for Cursor and Claude Code",
  "type": "module",
  "main": "index.js",
  "bin": {
    "generate-llm-rules": "./bin/generate.js"
  },
  "scripts": {
    "postinstall": "node ./bin/postinstall.js",
    "build": "rulesync generate --targets cursor,claudecode --features rules",
    "generate": "node ./bin/generate.js",
    "validate:rules": "node ./bin/validate-rules.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "gray-matter": "^4.0.3",
    "rulesync": "^5.9.0"
  }
}
